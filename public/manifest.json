{
  "manifest_version": 3,
  "name": "Tabbit: Tab Closer & Organizer",
  "version": "0.3",
  "description": "Close old tabs, manage bookmarks, and organize groups, quick as a rabbit.",
  "permissions": [
    "tabs",
    "scripting",
    "bookmarks",
    "tabGroups",
    "activeTab",
    "debugger",
    "alarms",
    "storage",
    "contextMenus",
    "idle"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Start Tab Triage",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}